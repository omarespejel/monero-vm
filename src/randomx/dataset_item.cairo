// ============================================================
// Dataset Item Generation for RandomX
// ============================================================
//
// Source: RandomX dataset.cpp
// Reference: https://github.com/tevador/RandomX/blob/master/src/dataset.cpp
//
// Each dataset item (64 bytes) is generated by:
// 1. Initialize registers based on item index
// 2. Execute 8 SuperscalarHash programs
// 3. XOR registers with cache entries after each program
// 4. Output final register state
//
// The SuperscalarHash programs are generated deterministically
// from the cache key using Blake2bGenerator.

use super::blake2b::{Blake2bGenerator, blake2b_generator_new};
use super::prototype::{Registers, generate_superscalar_program, execute_superscalar_program};

// ============================================================
// SuperscalarHash Constants
// From RandomX configuration.h
// ============================================================

/// Multiplier for r0 initialization
pub const SUPERSCALAR_MUL0: u64 = 6364136223846793005;

/// Additive constants for r1-r7 initialization
pub const SUPERSCALAR_ADD1: u64 = 9298411001130361340;
pub const SUPERSCALAR_ADD2: u64 = 12065312585734608966;
pub const SUPERSCALAR_ADD3: u64 = 9306329213124626780;  // From RandomX specs.md
pub const SUPERSCALAR_ADD4: u64 = 5281919268842080866;
pub const SUPERSCALAR_ADD5: u64 = 10536153434571861004;
pub const SUPERSCALAR_ADD6: u64 = 3398623926847679864;
pub const SUPERSCALAR_ADD7: u64 = 9549104520008361294;

/// Number of cache accesses per dataset item
pub const CACHE_ACCESSES: u32 = 8;

/// Number of SuperscalarHash programs per dataset item
pub const PROGRAMS_PER_ITEM: u32 = 8;

// ============================================================
// Dataset Item Structure
// ============================================================

/// 64-byte dataset item (8 × u64 registers)
#[derive(Copy, Drop)]
pub struct DatasetItem {
    pub r0: u64, pub r1: u64, pub r2: u64, pub r3: u64,
    pub r4: u64, pub r5: u64, pub r6: u64, pub r7: u64,
}

// ============================================================
// Dataset Item Generator
// ============================================================

#[derive(Copy, Drop)]
pub struct DatasetItemGenerator {
    pub blake_gen: Blake2bGenerator,
    pub programs_generated: u32,
}

// ============================================================
// Helper for wrapping arithmetic
// ============================================================

const MASK_64: u128 = 0xFFFFFFFFFFFFFFFF;

fn wrapping_mul_64(a: u64, b: u64) -> u64 {
    let a128: u128 = a.into();
    let b128: u128 = b.into();
    let result = (a128 * b128) & MASK_64;
    result.try_into().unwrap()
}

fn wrapping_add_64(a: u64, b: u64) -> u64 {
    let a128: u128 = a.into();
    let b128: u128 = b.into();
    let result = (a128 + b128) & MASK_64;
    result.try_into().unwrap()
}

// ============================================================
// Register Initialization
// ============================================================

/// Initialize registers for a dataset item based on item index
/// From RandomX dataset.cpp initDatasetItem()
pub fn init_dataset_registers(item_index: u64) -> Registers {
    // r0 = item_index * MUL0
    // r1 = item_index + ADD1
    // r2 = item_index + ADD2
    // ... etc
    Registers {
        r0: wrapping_mul_64(item_index, SUPERSCALAR_MUL0),
        r1: wrapping_add_64(item_index, SUPERSCALAR_ADD1),
        r2: wrapping_add_64(item_index, SUPERSCALAR_ADD2),
        r3: wrapping_add_64(item_index, SUPERSCALAR_ADD3),
        r4: wrapping_add_64(item_index, SUPERSCALAR_ADD4),
        r5: wrapping_add_64(item_index, SUPERSCALAR_ADD5),
        r6: wrapping_add_64(item_index, SUPERSCALAR_ADD6),
        r7: wrapping_add_64(item_index, SUPERSCALAR_ADD7),
    }
}

/// Apply SuperscalarHash constants after each program
/// r0 ^= MUL0, r1 ^= ADD1, etc.
pub fn apply_superscalar_constants(regs: Registers) -> Registers {
    Registers {
        r0: regs.r0 ^ SUPERSCALAR_MUL0,
        r1: regs.r1 ^ SUPERSCALAR_ADD1,
        r2: regs.r2 ^ SUPERSCALAR_ADD2,
        r3: regs.r3 ^ SUPERSCALAR_ADD3,
        r4: regs.r4 ^ SUPERSCALAR_ADD4,
        r5: regs.r5 ^ SUPERSCALAR_ADD5,
        r6: regs.r6 ^ SUPERSCALAR_ADD6,
        r7: regs.r7 ^ SUPERSCALAR_ADD7,
    }
}

// ============================================================
// Dataset Item Generator Functions
// ============================================================

/// Create a new dataset item generator from cache key
pub fn dataset_item_generator_new(key: Span<u8>) -> DatasetItemGenerator {
    let blake_gen = blake2b_generator_new(key, 0);
    
    DatasetItemGenerator {
        blake_gen: blake_gen,
        programs_generated: 0,
    }
}

/// Generate a single dataset item
/// This is a simplified version - full implementation needs cache integration
pub fn dataset_item_generate(
    gen: DatasetItemGenerator,
    item_index: u64
) -> (DatasetItemGenerator, DatasetItem) {
    // Initialize registers based on item index
    let mut regs = init_dataset_registers(item_index);
    
    // For each of 8 programs:
    // 1. Generate SuperscalarHash program
    // 2. Execute program on registers
    // 3. XOR with cache entry (simplified: just apply constants)
    
    let mut program_idx: u32 = 0;
    let mut current_gen = gen;
    
    loop {
        if program_idx == PROGRAMS_PER_ITEM {
            break;
        }
        
        // Generate seed for this program from Blake2b generator
        // In full implementation, this comes from blake_gen
        let program_seed = item_index + program_idx.into();
        
        // Generate and execute SuperscalarHash program
        let program = generate_superscalar_program(program_seed, 16);
        regs = execute_superscalar_program(regs, program.span());
        
        // Apply constants (simplified cache XOR)
        regs = apply_superscalar_constants(regs);
        
        program_idx += 1;
    }
    
    let new_gen = DatasetItemGenerator {
        blake_gen: current_gen.blake_gen,
        programs_generated: current_gen.programs_generated + PROGRAMS_PER_ITEM,
    };
    
    let item = DatasetItem {
        r0: regs.r0, r1: regs.r1, r2: regs.r2, r3: regs.r3,
        r4: regs.r4, r5: regs.r5, r6: regs.r6, r7: regs.r7,
    };
    
    (new_gen, item)
}

/// Convert DatasetItem to Registers (for further processing)
pub fn dataset_item_to_registers(item: DatasetItem) -> Registers {
    Registers {
        r0: item.r0, r1: item.r1, r2: item.r2, r3: item.r3,
        r4: item.r4, r5: item.r5, r6: item.r6, r7: item.r7,
    }
}

/// Convert Registers to DatasetItem
pub fn registers_to_dataset_item(regs: Registers) -> DatasetItem {
    DatasetItem {
        r0: regs.r0, r1: regs.r1, r2: regs.r2, r3: regs.r3,
        r4: regs.r4, r5: regs.r5, r6: regs.r6, r7: regs.r7,
    }
}
